# Written by `spi install` from spi.toml. Don't edit: change spi.toml and run
# `spi install` again, which writes this file again.
[Unit]
Description=Service Points {{name}}: {{description}}
After={{after}}
Wants={{wants}}
# Keep trying however many times it fails.
StartLimitIntervalSec=0

[Service]
Type=simple
User={{user}}
Group={{group}}
# The settings: KEY=VALUE lines. The first file is written by spi (the data
# folder, the settings file, the network); the second is yours and spi never
# overwrites it: put any secret there.
EnvironmentFile={{etc_dir}}/{{name}}.env
EnvironmentFile={{etc_dir}}/{{name}}.secret.env
# On every start, a restart after a crash included, the log is moved aside if it
# is over [service] log_max_size_mb, and only the newest [service] log_keep
# rotated logs stay (0 for either setting means no limit). A failed rotation
# never stops the start. While the service runs, sp-logs.timer keeps the log
# under the same cap.
ExecStartPre=-{{rotate_cmd}} {{log_dir}}/{{name}}.log
ExecStart={{bin_dir}}/{{name}} serve
# `systemctl reload` sends SIGHUP: the mint reads its settings file again and
# applies every setting that can change while it runs, with no stop. A setting
# that cannot (the mint's README marks each one "needs a restart") waits until
# the mint is restarted, which is a brief downtime: `spi restart` warns and asks
# first. A live snapshot is SIGUSR1 (`spi snapshot`).
ExecReload=/bin/kill -HUP $MAINPID

# Start again when it exits with an error or is killed. The delay grows from 5 s
# to 5 min. RestartSteps and RestartMaxDelaySec need systemd 254 or later; an
# older systemd warns about them, ignores them, and waits 5 s each time.
Restart=on-failure
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=300

# A stop sends SIGTERM. The mint finishes the work it is doing and exits with
# status 0; after TimeoutStopSec it is killed, and a kill is a crash the mint
# has to recover from. The longest a stop can take, step after step (psp-mint;
# esp-mint has no scan and is shorter): the scan finishes its current bitcoind
# call (bitcoin.rpc_timeout_secs, 30 s) + the AIR listener finishes the request
# it holds (3 replies x air.timeout_secs 10 s = 30 s) + the local API drains
# (30 s) + the runtime is dropped (5 s) + the watch thread (1 s) = 96 s. 120 s
# leaves the rest for sled to flush its files and for the process to exit. A
# usual stop takes a second or two.
KillSignal=SIGTERM
TimeoutStopSec=120

# The only places it may write: its data and its log.
ReadWritePaths={{data_dir}}/{{name}} {{log_dir}}
StandardOutput=append:{{log_dir}}/{{name}}.log
StandardError=append:{{log_dir}}/{{name}}.log
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome={{protect_home}}
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
