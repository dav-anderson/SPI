# Written by `spi install` from spi.toml. The timer starts it every {{minutes}}
# minutes, while the services run (they are meant never to stop, so the rotation
# at their start is not enough): a log over [service] log_max_size_mb is copied
# aside and emptied in place, and only the newest [service] log_keep .bak files
# stay (0 for either setting means no limit). The logs are the mints', the AIR
# server's, bitcoind's, the health monitors' and the scheduled upgrade's. It runs
# as root, because the health monitors and the scheduled upgrade write their logs
# as root, and it stops nothing.
[Unit]
Description=Service Points: keep the service logs under their size cap

[Service]
Type=oneshot
ExecStart={{spi_bin}} logs rotate --running --max-mb {{log_max_mb}} --keep {{log_keep}} {{logs}}
ReadWritePaths={{log_dir}}
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome={{protect_home}}
