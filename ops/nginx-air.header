# Written by `spi install` from spi.toml ([air] public_name, public_cert and
# public_key). Don't edit: change spi.toml and run `spi install` again. spi does
# not install this file: nginx's folders differ by system. Put it where your nginx
# reads its sites (for example /etc/nginx/conf.d/ on Linux, or
# /opt/homebrew/etc/nginx/servers/ on macOS with Homebrew), check it with
# `nginx -t`, and reload nginx.
#
# nginx answers on {{public_name}} and forwards the WebSocket to air_server,
# which listens on {{ws_addr}} on this machine. The mints and the SPI's wallet
# reach air_server directly on this machine and do not go through nginx.
