<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Written by spi install from spi.toml. Don't edit: change spi.toml and run
         spi install again, which writes this file again. Not written when [air]
         manage is false. -->
    <key>Label</key>
    <string>org.servicepoints.{{name}}</string>

    <!-- Not root. The settings are KEY=VALUE lines in the env file spi writes.
         exec makes air_server the process launchd watches, so a stop signal
         reaches it directly. -->
    <key>UserName</key>
    <string>{{user}}</string>
    <key>GroupName</key>
    <string>{{group}}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>set -a; . '{{etc_dir}}/air-server.env'; set +a; exec '{{bin_dir}}/air_server'</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{air_data_dir}}</string>

    <!-- Start at boot, and start again when it exits with an error or is killed.
         A clean exit (status 0, after a stop signal) is left alone. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>{{log_dir}}/air_server.log</string>
    <key>StandardErrorPath</key>
    <string>{{log_dir}}/air_server.log</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
